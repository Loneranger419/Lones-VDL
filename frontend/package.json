{
	"name": "lones-vdl-frontend",
	"private": true,
	"version": "2.0.0-dev",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"api": "uv run --project ../backend lones-vdl openapi -o src/lib/api/openapi.json && npm run api:types",
		"api:types": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22.20.5",
		"bits-ui": "^2.20.1",
		"cn": "^0.5.0",
		"openapi-typescript": "7.13.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		}
	},
	"dependencies": {
		"@tanstack/svelte-query": "6.3.5",
		"@videojs/html": "10.0.1",
		"mode-watcher": "1.1.0",
		"openapi-fetch": "0.17.0"
	}
}
