# Copy to deploy/.env (git-ignored) and edit for the Linux VM.

# Host path of the mounted archive share, bind-mounted to /archive in the container.
LONES_VDL_HOST_ARCHIVE=/mnt/lonesvdl

# Published port on the host.
LONES_VDL_PORT=8080

# User/group the app runs as. Match the owner of the archive share (see `id` on the VM
# and the uid/gid options of the CIFS mount).
PUID=1000
PGID=1000

TZ=America/New_York
