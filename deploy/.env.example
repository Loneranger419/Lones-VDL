# Copy to deploy/.env and edit. Never commit deploy/.env.

# Required: API bearer token (UI login + mutating routes).
LONES_VDL_API_TOKEN=change-me

# Host path bind-mounted to /archive inside the container.
# Linux/NAS example: /mnt/nas/lones-vdl-archive
# Local smoke from repo: ../data/archive
LONES_VDL_HOST_ARCHIVE=../data/archive

# Host path bind-mounted read-only to /secrets (cookies, etc.).
LONES_VDL_HOST_SECRETS=../secrets

# Published port on the host.
LONES_VDL_PORT=8080

# Optional Netscape cookies inside the container (file must exist under /secrets).
# LONES_VDL_YTDLP_COOKIES_FILE=/secrets/cookies.txt

# Optional runtime knobs (also overridable via compose environment).
LONES_VDL_COOKIE_PLATFORMS=youtube,twitch
LONES_VDL_DOWNLOAD_CONCURRENCY=1
LONES_VDL_DOWNLOAD_MAX_ATTEMPTS=3
LONES_VDL_DEFAULT_QUALITY=best
LONES_VDL_CHANNEL_WATCH_INTERVAL_HOURS=6
