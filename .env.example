# Copy to .env and adjust. Never commit .env or cookie files.

# Bind address: use a LAN interface IP in production; 127.0.0.1 for local-only.
LONES_VDL_HOST=127.0.0.1
LONES_VDL_PORT=8080

# Shared API bearer token (required for mutating routes; recommended for all API access).
LONES_VDL_API_TOKEN=change-me

# Archive root: local folder on Windows during development; NAS mount on Linux later.
LONES_VDL_ARCHIVE_ROOT=./data/archive

# SQLite path: keep on local disk, not on SMB/NFS.
LONES_VDL_DATABASE_PATH=./data/lones_vdl.db

# Optional Netscape cookies.txt for yt-dlp (age-gated / members content you can access).
# LONES_VDL_YTDLP_COOKIES_FILE=./secrets/youtube.cookies.txt

# Platforms whose cookie domains are kept when filtering (comma-separated).
LONES_VDL_COOKIE_PLATFORMS=youtube,twitch

# yt-dlp executable name or path (must be on PATH for real downloads).
LONES_VDL_YTDLP_EXECUTABLE=yt-dlp

# Download worker settings
LONES_VDL_DOWNLOAD_CONCURRENCY=1
LONES_VDL_DOWNLOAD_MAX_ATTEMPTS=3
LONES_VDL_DEFAULT_QUALITY=best

# Hours between automatic checks of channels with "watch" enabled (0 disables the poller).
LONES_VDL_CHANNEL_WATCH_INTERVAL_HOURS=6
