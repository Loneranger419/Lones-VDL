# Local development on Windows. Copy to .env (git-ignored) at the repo root.
# Docker settings live in deploy/.env instead.

LONES_VDL_HOST=127.0.0.1
LONES_VDL_PORT=8080
LONES_VDL_LOG_LEVEL=info

# Local disk: database, secrets (cookies), yt-dlp venv, job logs.
LONES_VDL_DATA_DIR=./data

# Media archive. A local folder while developing.
LONES_VDL_ARCHIVE_ROOT=./data/archive

# Built frontend. Leave unset to auto-detect frontend/build.
# LONES_VDL_FRONTEND_DIST=./frontend/build
