# Secrets and local config
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep
# Netscape cookie jars and editor/filter backups (any path)
cookies.txt
cookies.txt.*
*.cookies.txt
*.cookies.txt.*
*.cookies.bak

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
frontend/build/
frontend/.svelte-kit/

# Runtime data (never commit archive or DB)
data/*
!data/archive/
data/archive/*
!data/archive/.gitkeep
!data/**/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
/archive
/archive/

# yt-dlp / download temps (if ever written outside data/archive)
*.part
*.ytdl
*.temp
*.tmp

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Docker
.docker-cache/
deploy/.env
!deploy/.env.example
